{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "urn:designflow:schema:v1:authoring-port",
  "title": "AuthoringBackend synchronous port v1",
  "$defs": {
    "input": {
      "type": "object",
      "additionalProperties": false,
      "required": ["request", "snapshot", "invocationKey"],
      "properties": {
        "request": { "$ref": "urn:designflow:schema:v1:design-request" },
        "snapshot": { "$ref": "urn:designflow:schema:v1:authoring-context-snapshot" },
        "invocationKey": { "$ref": "urn:designflow:schema:v1:common#/$defs/identifier" }
      }
    },
    "failure": {
      "type": "object",
      "additionalProperties": false,
      "required": ["ok", "kind", "detail"],
      "properties": {
        "ok": { "const": false },
        "kind": {
          "enum": [
            "schema-invalid",
            "trace-broken",
            "provenance-invalid",
            "source-mutation",
            "ambiguous",
            "provider-unavailable"
          ]
        },
        "detail": true
      }
    },
    "authorExperienceResult": {
      "oneOf": [
        {
          "type": "object",
          "additionalProperties": false,
          "required": ["ok", "artifact"],
          "properties": {
            "ok": { "const": true },
            "artifact": { "$ref": "urn:designflow:schema:v1:experience-contract" }
          }
        },
        { "$ref": "#/$defs/failure" }
      ]
    },
    "authorDesignSystemDeltaResult": {
      "oneOf": [
        {
          "type": "object",
          "additionalProperties": false,
          "required": ["ok", "artifact"],
          "properties": {
            "ok": { "const": true },
            "artifact": { "$ref": "urn:designflow:schema:v1:design-system-delta" }
          }
        },
        { "$ref": "#/$defs/failure" }
      ]
    },
    "deriveCapabilitiesResult": {
      "oneOf": [
        {
          "type": "object",
          "additionalProperties": false,
          "required": ["ok", "artifact"],
          "properties": {
            "ok": { "const": true },
            "artifact": { "$ref": "urn:designflow:schema:v1:capability-requirements" }
          }
        },
        { "$ref": "#/$defs/failure" }
      ]
    }
  }
}
