  "$schema":"https://json-schema.org/draft/2020-12/schema","$id":"urn:forma:schema:v1:revision-state-snapshot","title":"Revision state snapshot v1","type":"object","additionalProperties":false,"required":["schemaVersion","requestId","revisions","decisions","feedbackDispositions"],
