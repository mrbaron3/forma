{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "urn:forma:schema:v1:approval-validity",
  "title": "Derived approval validity v1",
  "oneOf": [
    {
      "type": "object", "additionalProperties": false,
      "required": ["schemaVersion", "requestId", "revisionId", "bundleDigest", "status", "reason", "decisionId"],
      "properties": {
        "schemaVersion": { "const": "1.0" }, "requestId": { "$ref": "urn:forma:schema:v1:common#/$defs/identifier" },
        "revisionId": { "$ref": "urn:forma:schema:v1:common#/$defs/identifier" }, "bundleDigest": { "$ref": "urn:forma:schema:v1:common#/$defs/sha256" },
        "status": { "const": "missing" }, "reason": { "type": "null" }, "decisionId": { "type": "null" }
      }
    },
    {
      "type": "object", "additionalProperties": false,
      "required": ["schemaVersion", "requestId", "revisionId", "bundleDigest", "status", "reason", "decisionId"],
      "properties": {
        "schemaVersion": { "const": "1.0" }, "requestId": { "$ref": "urn:forma:schema:v1:common#/$defs/identifier" },
        "revisionId": { "$ref": "urn:forma:schema:v1:common#/$defs/identifier" }, "bundleDigest": { "$ref": "urn:forma:schema:v1:common#/$defs/sha256" },
        "status": { "const": "valid" }, "reason": { "type": "null" }, "decisionId": { "$ref": "urn:forma:schema:v1:common#/$defs/identifier" }
      }
    },
    {
      "type": "object", "additionalProperties": false,
      "required": ["schemaVersion", "requestId", "revisionId", "bundleDigest", "status", "reason", "decisionId"],
      "properties": {
        "schemaVersion": { "const": "1.0" }, "requestId": { "$ref": "urn:forma:schema:v1:common#/$defs/identifier" },
        "revisionId": { "$ref": "urn:forma:schema:v1:common#/$defs/identifier" }, "bundleDigest": { "$ref": "urn:forma:schema:v1:common#/$defs/sha256" },
        "status": { "const": "stale" }, "reason": { "enum": ["request-mismatch", "revision-mismatch", "bundle-mismatch", "revision-superseded"] },
        "decisionId": { "$ref": "urn:forma:schema:v1:common#/$defs/identifier" }
      }
    }
  ]
}
