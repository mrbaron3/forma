{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "urn:forma:schema:v1:authoring-ambiguity-report",
  "title": "AuthoringAmbiguityReport v1",
  "type": "object",
  "additionalProperties": false,
  "required": ["schemaVersion", "requestId", "invocationKey", "targetArtifact", "ambiguities"],
  "properties": {
    "schemaVersion": { "const": "1.0" },
    "requestId": { "$ref": "urn:forma:schema:v1:common#/$defs/identifier" },
    "invocationKey": { "$ref": "urn:forma:schema:v1:common#/$defs/identifier" },
    "targetArtifact": {
      "enum": ["experience", "designSystemDelta", "capabilityRequirements"]
    },
    "ambiguities": {
      "type": "array",
      "minItems": 1,
      "items": { "$ref": "urn:forma:schema:v1:common#/$defs/ambiguity" },
      "contains": {
        "type": "object",
        "required": ["blocks"],
        "properties": {
          "blocks": { "const": true }
        }
      },
      "minContains": 1
    }
  }
}
