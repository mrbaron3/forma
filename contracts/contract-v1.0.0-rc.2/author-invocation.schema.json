{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "urn:designflow:schema:contract-v1.0.0-rc.2:author-invocation",
  "type": "object",
  "additionalProperties": false,
  "required": ["invocationKey", "provider", "toolOrModel", "profileRevision", "inputContextDigest", "instructionDigest", "outputDigest"],
  "properties": {
