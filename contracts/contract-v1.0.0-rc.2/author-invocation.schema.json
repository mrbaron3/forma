    "provider": { "$ref": "urn:designflow:schema:contract-v1.0.0-rc.2:common#/$defs/nonEmptyString" },
    "toolOrModel": { "$ref": "urn:designflow:schema:contract-v1.0.0-rc.2:common#/$defs/nonEmptyString" },
    "orchestrator": { "$ref": "urn:designflow:schema:contract-v1.0.0-rc.2:common#/$defs/nonEmptyString" },
    "profileRevision": { "$ref": "urn:designflow:schema:contract-v1.0.0-rc.2:common#/$defs/nonEmptyString" },
    "inputContextDigest": { "$ref": "urn:designflow:schema:contract-v1.0.0-rc.2:common#/$defs/sha256" },
